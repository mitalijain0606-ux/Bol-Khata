# ============ Bol-Khata configuration ============
# Copy this file to .env and fill in your speech API keys.
# Everything is OPTIONAL — with no keys the app runs in
# Mock Mode (browser speech + rule-based agent) so you can
# demo the full flow for free before switching to cloud speech.

# --- Speech providers (cloud STT/TTS) ---
SPEECH_API_KEY=
SPEECH_API_BASE=https://api.vachana.ai
STT_REST_PATH=/stt/v3
STT_WS_PATH=/stt/v3/stream
TTS_REST_PATH=/api/v1/tts/inference
TTS_WS_PATH=/api/v1/tts
TTS_MODEL=timbre-v2.5

# Voice names from the provider's voice catalog
TTS_VOICE_AGENT=Poorvi
TTS_VOICE_CUSTOMER_1=Deepak
TTS_VOICE_CUSTOMER_2=Nalini
TTS_VOICE_CUSTOMER_3=Kaveri

# STT language code: hi-IN, en-IN, mr-IN, ta-IN, kn-IN, bn-IN, gu-IN, pa-IN, ml-IN, te-IN
STT_LANG=hi-IN

# --- Reasoning LLM (any OpenAI-compatible /chat/completions endpoint) ---
# Leave empty to run on the built-in Hinglish rule engine (no LLM calls).
#
# Groq (tested):
#   LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=openai/gpt-oss-20b
#
# Any other OpenAI-compatible server (vLLM, Ollama, a hosted open-weights
# model) works the same way — give its /chat/completions URL and model id.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Option B: Hugging Face inference instead of an endpoint
LLM_HF_MODEL=
# (the older EVON_* spellings of these four are still accepted)

# --- Voice lock (speaker verification) ---
VOICE_LOCK_ENABLED=1
VOICE_LOCK_THRESHOLD=0.55
