# ============ Bol-Khata configuration ============
# Copy this file to .env and fill in your Gnani keys.
# Everything is OPTIONAL — with no keys the app runs in
# Mock Mode (browser speech + rule-based agent) so you can
# demo the full flow for free before switching to Gnani.

# --- Speech providers (cloud STT/TTS) ---
SPEECH_API_KEY=
SPEECH_API_BASE=https://api.vachana.ai
STT_REST_PATH=/stt/v3
STT_WS_PATH=/stt/v3/stream
TTS_REST_PATH=/api/v1/tts/inference
TTS_WS_PATH=/api/v1/tts
TTS_MODEL=timbre-v2.5

# Voice names from the provider's voice catalog
TTS_VOICE_AGENT=Poorvi
TTS_VOICE_CUSTOMER_1=Deepak
TTS_VOICE_CUSTOMER_2=Nalini
TTS_VOICE_CUSTOMER_3=Kaveri

# STT language code: hi-IN, en-IN, mr-IN, ta-IN, kn-IN, bn-IN, gu-IN, pa-IN, ml-IN, te-IN
STT_LANG=hi-IN

# --- Evon v3.3 reasoning model ---
# Option A: platform/compatible endpoint (OpenAI-style /chat/completions)
EVON_API_URL=
EVON_API_KEY=
EVON_MODEL=evon-v3.3
# Option B: Hugging Face open weights (after your HF request is approved)
EVON_HF_MODEL=

# --- Voice lock (speaker verification) ---
VOICE_LOCK_ENABLED=1
VOICE_LOCK_THRESHOLD=0.55
