# ============ Bol-Khata configuration ============
# Copy this file to .env and fill in your Gnani keys.
# Everything is OPTIONAL — with no keys the app runs in
# Mock Mode (browser speech + rule-based agent) so you can
# demo the full flow for free before switching to Gnani.

# --- Gnani platform (app.gnani.ai -> dashboard -> generate key) ---
GNANI_API_KEY_ID=
GNANI_API_BASE=https://api.vachana.ai

# Exact endpoint paths — copy these from docs.gnani.ai quickstart
# after you have API access. Placeholders below match the documented
# service names; adjust if the quickstart shows different paths.
GNANI_STT_REST_PATH=/v1/speech/to/text
GNANI_STT_WS_PATH=/v1/speech/to/text/ws
GNANI_TTS_REST_PATH=/v1/text/to/speech
GNANI_TTS_WS_PATH=/v1/text/to/speech/ws

# Voice IDs picked from the Timbre voice catalog (app.gnani.ai/voice)
GNANI_TTS_VOICE_AGENT=          # voice for Bol-Khata agent (Hinglish)
GNANI_TTS_VOICE_CUSTOMER_1=     # fake debtor persona 1
GNANI_TTS_VOICE_CUSTOMER_2=     # fake debtor persona 2
GNANI_TTS_VOICE_CUSTOMER_3=     # fake debtor persona 3

# STT language hint (hi-IN / en-IN / mr-IN / ta-IN ...)
GNANI_STT_LANG=hi-IN

# --- Evon v3.3 reasoning model ---
# Option A: platform/compatible endpoint (OpenAI-style /chat/completions)
EVON_API_URL=
EVON_API_KEY=
EVON_MODEL=evon-v3.3
# Option B: Hugging Face open weights (after your HF request is approved)
EVON_HF_MODEL=

# --- Voice lock (speaker verification) ---
VOICE_LOCK_ENABLED=1
VOICE_LOCK_THRESHOLD=0.55
